- id: cfg_21c8c00165b3
  name: "Validated #1 — DOWN-only deep dip (88% WR backtest)"
  enabled: true
  starting_capital_usd: 1000.0
  timeframe: "15m"
  sim_config:
    entry:
      side: "DOWN"
      entry_price_min: 0.075
      entry_price_max: 0.125
      drop_magnitude_pct: 15.0
      drop_window_sec: 30
      min_time_left_sec: 180
      proximity_max_pct: 0.5
      min_seconds_into_window: 15
    exit:
      profit_target_pct: 50.0
      stop_loss_pct: 80
      max_hold_sec: 180
      trailing_stop_pct: null
    filter:
      min_book_depth_usd: 15.0
      max_spread: 0.10
      book_imbalance_min: null
      vol_regime: "ALL"
      time_of_day: "ALL"
      multi_tier_entry: 1
      correlated_signal_filter: false
    human:
      reaction_delay_min_sec: 0.0
      reaction_delay_max_sec: 2.5
      signal_skip_prob: 0.12
      daily_trade_cap: 25
      post_loss_cooldown_sec: 60
      concurrent_position_cap: 1
      fixed_bet_usd: 10.0
    fill:
      fee_rate: 0.07
      reject_prob: 0.06
      use_next_tick_for_fill: true
      realistic_fill_model: true

